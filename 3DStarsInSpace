//Random

float randomSpacing(vec2 p) {
    p = fract(sin(p * vec2(127.1, 311.7)) * 43758.5453123);
    return p.x;
}

vec2 randomOffset(float seed) 
{
    vec2 xy = vec2(seed, seed * 1.3);
 
    return fract(sin(vec2(
        dot(xy, vec2(12.9898, 78.233)),
        dot(xy, vec2(39.3468, 11.135))
    )) * 43758.5453);
}

float GetDensity(vec3 p) {
    return (exp(-p.y * 0.01f));
}

//SDFs from https://iquilezles.org/

float sdStar( in vec2 p, in float r, in int n, in float m)
{
    // next 4 lines can be precomputed for a given shape
    float an = 3.141593/float(n);
    float en = 3.141593/m;  // m is between 2 and n
    vec2  acs = vec2(cos(an),sin(an));
    vec2  ecs = vec2(cos(en),sin(en)); // ecs=vec2(0,1) for regular polygon

    float bn = mod(atan(p.x,p.y),2.0*an) - an;
    p = length(p)*vec2(cos(bn),abs(sin(bn)));
    p -= r*acs;
    p += ecs*clamp( -dot(p,ecs), 0.0, r*acs.y/ecs.y);
    return length(p)*sign(p.x);
}

float sdHexagram( in vec2 p, in float r )
{
    const vec4 k = vec4(-0.5,0.8660254038,0.5773502692,1.7320508076);
    p = abs(p);
    p -= 2.0*min(dot(k.xy,p),0.0)*k.xy;
    p -= 2.0*min(dot(k.yx,p),0.0)*k.yx;
    p -= vec2(clamp(p.x,r*k.z,r*k.w),r);
    return length(p)*sign(p.y);
}

float sdPentagram(in vec2 p, in float r )
{
    const float k1x = 0.809016994; // cos(π/ 5) = ¼(√5+1)
    const float k2x = 0.309016994; // sin(π/10) = ¼(√5-1)
    const float k1y = 0.587785252; // sin(π/ 5) = ¼√(10-2√5)
    const float k2y = 0.951056516; // cos(π/10) = ¼√(10+2√5)
    const float k1z = 0.726542528; // tan(π/ 5) = √(5-2√5)
    const vec2  v1  = vec2( k1x,-k1y);
    const vec2  v2  = vec2(-k1x,-k1y);
    const vec2  v3  = vec2( k2x,-k2y);
    
    p.x = abs(p.x);
    p -= 2.0*max(dot(v1,p),0.0)*v1;
    p -= 2.0*max(dot(v2,p),0.0)*v2;
    p.x = abs(p.x);
    p.y -= r;
    return length(p-v3*clamp(dot(p,v3),0.0,k1z*r))
           * sign(p.y*v3.x-p.x*v3.y);
}

float opExtrudeStar(vec3 p, float h, float scale) {

    vec3 scaleP = p / scale;
    float d = sdPentagram(scaleP.xy, 0.5f); 
    
    vec2 w = vec2(d, abs(scaleP.z) - h);
    
    float distance = min(max(w.x, w.y), 0.0) + length(max(w, 0.0));
    return distance*scale;
}
float opExtrudeHex(vec3 p, float h, float scale) {

    vec3 scaleP = p / scale;
    float d = sdHexagram(scaleP.xy, 0.5f); 
    
    vec2 w = vec2(d, abs(scaleP.z) - h);
    
    float distance = min(max(w.x, w.y), 0.0) + length(max(w, 0.0));
    return distance*scale;
}
float opExtrudeRealStar(vec3 p, float h, float scale) {

    vec3 scaleP = p / scale;
    float d = sdStar(scaleP.xy, 0.5f, 5, 2.5f); 
    
    vec2 w = vec2(d, abs(scaleP.z) - h);
    
    float distance = min(max(w.x, w.y), 0.0) + length(max(w, 0.0));
    return distance*scale;
}


//Rot matrix
    
mat3 rotate3D(vec3 angles) {
    vec3 c = cos(angles);
    vec3 s = sin(angles);
    
    mat3 rx = mat3(1.0, 0.0, 0.0, 0.0, c.x, s.x, 0.0, -s.x, c.x);
    mat3 ry = mat3(c.y, 0.0, -s.y, 0.0, 1.0, 0.0, s.y, 0.0, c.y);
    mat3 rz = mat3(c.z, s.z, 0.0, -s.z, c.z, 0.0, 0.0, 0.0, 1.0);
    
    return rz * ry * rx;
}

vec4 rayMarchStar(vec3 uv3D, inout vec3 posShapeStar, vec3 localCamPos, out float distanceFog)
{
    float totalDistanceStar = 0.0f;
    float GTime = clamp(sin((iTime*2.0f)+10.0f)/2.0f, 0.1f, 9.0f);
    
    vec2 rando = randomOffset(iTime);
    
    vec3 movement = vec3(sin(GTime * 2.0) * 3.0, 2.0, localCamPos.z + 12.0);
    vec3 movement1 = vec3(cos(GTime * 2.0) * 4.0, 1.0, localCamPos.z + 15.0);
    vec3 movement2 = vec3(-sin(GTime * 2.0) * 3.0, -1.0, localCamPos.z + 10.0);
    vec3 movement3 = vec3(sin(GTime * 1.5) * 5.0, 3.0, localCamPos.z + 18.0);
    vec3 movement4 = vec3(cos(GTime * 1.5) * 2.0, -2.0, localCamPos.z + 14.0);
    vec3 movement5 = vec3(-cos(GTime * 2.0) * 4.0, 0.0, localCamPos.z + 16.0);
        
    float glow = 0.0; 
        
    for(int i = 0; i < maxDistance; i++)
    {   
        posShapeStar = localCamPos + uv3D * totalDistanceStar;
        
        vec3 starOffset1 = vec3(0.0f, -5.0f, 0.0f);
        vec3 starOffset2 = vec3(-4.0f, -2.0f, -5.0f); 
        vec3 starOffset3 = vec3(4.0f, -3.0f, -0.0f);
        vec3 starOffset4 = vec3(2.5f, 2.2f, 4.2);
        vec3 starOffset5 = vec3(-2.0f, 3.0f, -4.0f); 
        vec3 starOffset6 = vec3(2.0f, -6.0f, -0.0f);
        
        vec3 p1 = posShapeStar - movement - starOffset1 + sin(iTime);
        vec3 p2 = posShapeStar - movement1 - starOffset2 + cos(iTime);
        vec3 p3 = posShapeStar - movement2 - starOffset3 + tan(iTime); 
        vec3 p4 = posShapeStar - movement3 - starOffset4 + sin(iTime);
        vec3 p5 = posShapeStar - movement4 - starOffset5 + cos(iTime);
        vec3 p6 = posShapeStar - movement5 - starOffset6 + tan(iTime); 
        
        vec3 transformed1 = rotate3D(vec3(0.0f, 0.0f, iTime)) * p1;
        vec3 transformed2 = rotate3D(vec3(0.0f, 0.0f, iTime)) * p2;
        vec3 transformed3 = rotate3D(vec3(0.0f, 0.0f, iTime)) * p3;
        vec3 transformed4 = rotate3D(vec3(0.0f, 0.0f, iTime)) * p4;
        vec3 transformed5 = rotate3D(vec3(0.0f, 0.0f, iTime)) * p5;
        vec3 transformed6 = rotate3D(vec3(0.0f, 0.0f, iTime)) * p6;  
           
        float starDistanceX = 
        min((opExtrudeStar(transformed1, 0.2f, 5.0f*GTime)), 
        opExtrudeStar(transformed2, 0.2f, 5.0f/2.0f*GTime));
        
        float starDistanceY =
        min((opExtrudeStar(transformed3, 0.2f, 5.0f*GTime)), 
        starDistanceX);
        
        float starDistanceZ =
        min((opExtrudeStar(transformed4, 0.2f, 5.0f*GTime)), 
        starDistanceY);
        
        float starDistanceU =
        min((opExtrudeStar(transformed5, 0.2f, 5.0f*GTime)), 
        starDistanceZ);
        float starDistance =
        min((opExtrudeStar(transformed6, 0.2f, 5.0f*GTime)), 
        starDistanceU);
        
        float d = starDistance;
        
        vec3 N = vec3(0.0f);
        
        if (starDistance < 0.001f) {
    float e = 0.001; 
    
    

    float dX = opExtrudeStar(rotate3D(vec3(0.0, 0.0, iTime)) * ((posShapeStar + vec3(e, 0.0, 0.0)) - movement - starOffset1 + sin(iTime)), 0.1f, 5.0f * GTime);
    float dY = opExtrudeStar(rotate3D(vec3(0.0, 0.0, iTime)) * ((posShapeStar + vec3(0.0, e, 0.0)) - movement - starOffset1 + sin(iTime)), 0.1f, 5.0f * GTime);
    float dZ = opExtrudeStar(rotate3D(vec3(0.0, 0.0, iTime)) * ((posShapeStar + vec3(0.0, 0.0, e)) - movement - starOffset1 + sin(iTime)), 0.1f, 5.0f * GTime);
    

    N = normalize(vec3(dX - starDistance, dY - starDistance, dZ - starDistance));
    }
        vec3 L = -lightDir;
        vec3 V = -uv3D;
        vec3 H = normalize(L + V);
            
            
            
        float diffuse = max(dot(N, L), 0.0);
        float specular = pow(max(dot(N, H), 0.0), 32.0);
        float ambient = 0.25;
         
        vec3 surfaceShading = starColor * (ambient + diffuse * lightColor) + vec3(1.0,1.0,1.0) * specular;
       
        glow += 0.01 / (0.05 + abs(d));
       
        totalDistanceStar += starDistance;

        if(totalDistanceStar > 80.0f)
        {
            return vec4(0.0f);
        }
        else if(starDistance < 0.001f)
        {
            return vec4(surfaceShading, 1.0);
        }
    }
    return vec4(0.0f);     
}

float rayMarchTwinkle(vec3 uv3D, inout vec3 posShapeStar, vec3 localCamPos)
{
    float totalDistanceStar = 0.0f;
    float GTime = mod(iTime, 2.0f)/20.0f;

    float loopID = floor(iTime);
    
    vec2 rando = randomOffset(loopID)*15.0f;

    vec3 localPos;

    for(int i = 0; i < maxDistance; i++)
    {   
    
            
        posShapeStar = localCamPos + uv3D * totalDistanceStar;
        

    
        vec3 uvGrid = posShapeStar / gridSpacing;
        vec3 cellID = floor(uvGrid);
        vec2 numDel = randomOffset(cellID.y);
        vec3 localUV = (fract(uvGrid) - 0.5) - vec3(rando.xy, 0.0f);
               
                
        float randVal = randomSpacing(cellID.xy + cellID.z);
        vec2 cellRandomOffset = randomOffset(randVal) * 1.2;
        
        
        localPos = mod(posShapeStar, gridSpacing) - (gridSpacing * 0.5);
        
        float timeSin = (sin(mod(iTime*2.0f, 2.0f))+1.0f)/2.0f; 
        
        float minTwinkle = mix(
        opExtrudeHex(localPos, 0.2f, clamp((sin(iTime) + 0.5) / 5.0, 0.01, 0.8)), 
        opExtrudeRealStar(localPos, 0.2f, clamp((sin(iTime) + 0.5) / 5.0, 0.5, 1.0)),        
        abs(cos(iTime * 2.5)));
        
        
        max(minTwinkle, 0.01f);
        
        vec2 RandInput = cellID.xy + vec2(cellID.z * 17.1, cellID.z * 31.7);
        float cellNoise = randomSpacing(RandInput);

        if (cellNoise < 0.6) {
        minTwinkle = gridSpacing.x; 
        }

        totalDistanceStar += minTwinkle;

        if(totalDistanceStar > 80.0f)
        {
            return 0.0f;
        }
        else if(minTwinkle < 0.01f)
        {
            return totalDistanceStar;
        }
    }
    return 0.0f;     
}

const float maxDist = 80.0;
const int samples = 64; 
const float stepSize = maxDist / float(samples);

//Fog adapted from TheJinxedArtist

float RayMarchFog(vec3 ro, vec3 rd, float sceneDepth) {
    float d = 0.0;
    float accumulatedFog = 0.0;
    
    for(int i = 0; i < samples; i++) {
        if(d >= sceneDepth) break;
        
        vec3 p = ro + rd * d;
        if(dot(rd, vec3(0.0, 1.0, 0.0)) > 0.01 && p.y > 0.01) break;
        
        float density = GetDensity(p);
        accumulatedFog += density * stepSize * 0.08;
        d += stepSize;
    }
    return accumulatedFog;
}

void mainImage( out vec4 fragColor, in vec2 fragCoord )
{   
    vec3 localCamPos = camPos;
    localCamPos *= rotate3D(vec3(iTime*4.0f, 0.0f, 0.0f));
    localCamPos += vec3(0.0,-2.0f,iTime*30.0f);

    vec2 uv = (fragCoord - 0.5f * iResolution.xy) / iResolution.y;
    
    vec3 uv3D = normalize(vec3(uv.x, uv.y, 1.5f));
   
    vec3 twinkleColor = vec3(1.0f);
    vec3 posShapeStar; 
    
    vec3 col = vec3(0.02, 0.043, 0.2);
    fragColor = vec4(col, 1.0f);
    
    
    float fogDensity = RayMarchFog(localCamPos, uv3D, 20.0f);
    float fogFactor = 1.0 - exp(-fogDensity);
    col = mix(col, vec3(0.1, 0.15, 0.25), fogFactor);

    fragColor = vec4(col, 1.0);
    
    
    
    if(rayMarchStar(uv3D, posShapeStar, localCamPos, distanceFog) != vec4(0.0f))
    {
        fragColor = vec4(rayMarchStar(uv3D, posShapeStar, localCamPos, distanceFog));
    }
    else if(rayMarchTwinkle(uv3D, posShapeStar, localCamPos) != 0.0f)
    {
        fragColor = vec4((twinkleColor), 1.0f);
    }
    
}


